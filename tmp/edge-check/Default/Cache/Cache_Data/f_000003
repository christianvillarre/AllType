  .menu-subitem {
    justify-self: start;
    width: fit-content;
    background-image: none;
    opacity: 1;
  }

  .menu-subitem::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 10px;
    border-top: 1.5px solid #fff;
    border-right: 1.5px solid #fff;
    opacity: 0;
    transform: translate(-5px, -1px) rotate(45deg);
    transition: opacity .2s ease, transform .2s ease;
  }

  .menu-subitem:hover,
  .menu-subitem:focus-visible {
    color: #fff;
    text-decoration: none;
    transform: translateX(6px);
  }

  .menu-subitem:hover::after,
  .menu-subitem:focus-visible::after {
    opacity: 1;
    transform: translate(0, -1px) rotate(45deg);
  }

  .menu-panel.items-pending .menu-link,
  .menu-panel.items-pending .menu-service-tab,
  .menu-panel.items-pending .menu-subitem,
  .menu-panel.items-pending .menu-service-detail { transform: translateY(24px); }
}

@media (max-width: 991px) {
  .menu-panel-inner { grid-template-rows: auto minmax(0, 1fr); }
  .menu-sublist { gap: 0; }
  .menu-service-detail { font-size: 17px; }
}

@media (min-width: 600px) and (max-width: 991px) {
  .menu-service-group.is-active {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 12px;
  }
}

/* Keep the desktop red services menu readable on touch screens. */
@media (max-width: 991px) {
  .menu-panel {
    background: #c81017;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  .menu-panel::before,
  .menu-left-bottom,
  .menu-right > .office-block,
  .menu-right-top .menu-section-title { display: none; }

  .menu-panel-inner {
    height: auto;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(155px, 30%) minmax(0, 1fr);
    grid-template-rows: 1fr;
    align-items: stretch;
    gap: clamp(18px, 3vw, 32px);
    padding-top: 110px;
    padding-bottom: 100px;
  }

  .menu-panel-top {
    border-bottom: 1px solid #fff;
    padding-bottom: 12px;
  }

  .menu-left {
    position: relative;
    padding-right: clamp(12px, 2vw, 24px);
  }

  .menu-left::after {
    content: "";
    position: absolute;
    top: -110px;
    right: 0;
    bottom: -100px;
    width: 1px;
    background: #fff;
  }

  .menu-link {
    width: fit-content;
    color: #fff;
    background-image: none;
    font-size: clamp(24px, 4vw, 40px);
    line-height: 1;
  }

  .menu-link:hover,
  .menu-link:focus-visible { color: #fff; transform: translateX(5px); }

  .menu-right {
    overflow: visible;
    padding: 4px 0 0;
  }

  .menu-service-group.is-active {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .menu-service-column { gap: 10px; }

  .menu-subitem {
    width: fit-content;
    color: #fff;
    background-image: none;
    font-size: clamp(15px, 2.2vw, 19px);
    line-height: 1.2;
    opacity: 1;
  }

  .menu-subitem::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-left: 7px;
    border-top: 1.5px solid #fff;
    border-right: 1.5px solid #fff;
    opacity: 0;
    transform: translate(-4px, -1px) rotate(45deg);
    transition: opacity .2s ease, transform .2s ease;
  }

  .menu-subitem:hover,
  .menu-subitem:focus-visible { color: #fff; transform: translateX(5px); }
  .menu-subitem:hover::after,
  .menu-subitem:focus-visible::after {
    opacity: 1;
    transform: translate(0, -1px) rotate(45deg);
  }
}

@media (max-width: 767px) {
  .menu-panel { overflow: hidden; }

  .menu-panel-inner {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    min-height: 0;
    gap: 0;
    padding-top: 86px;
    padding-bottom: calc(105px + env(safe-area-inset-bottom));
  }

  .menu-left { flex: 0 0 auto; padding: 0 0 16px; border: 0; }
  .menu-left::after { display: none; }
  .menu-list { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 4px; }
  .menu-link {
    display: block;
    width: auto;
    font-size: clamp(14px, 4vw, 20px);
    padding: 4px 0;
    white-space: nowrap;
  }

  .menu-right {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 10px 8px 0 0;
  }

  .menu-service-group.is-active { display: block; }
  .menu-service-column { gap: 10px; margin-bottom: 22px; }
  .menu-subitem {
    font-size: clamp(16px, 4.5vw, 19px);
    line-height: 1.25;
    padding: 2px 0;
  }

  .menu-service-column .menu-subitem:first-child {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
    margin-bottom: 4px;
  }
}

/* ALWAYS visible menu button */
.menu-btn{
  background: transparent;
  color: #fff;
  border: none;
  padding: 0;
  width: 75px;
  height: 75px;
  overflow: visible;
  border-radius: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform .18s ease, background-color .2s ease, color .2s ease;
  position: relative;
  z-index: 210;
}

.menu-btn-fixed{
  position: fixed;
  top: 22px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 260;
}

.menu-btn-fixed:hover{
  transform: translateX(-50%) translateY(-1px);
}

.menu-btn-backdrop{
  position: absolute;
  top: 50%;
  left: 50%;
  width: 200%;
  height: 70%;
  border-radius: 60px;
  transform: translate(-50%, -50%);
  display: block;
  background: rgb(255, 255, 255);
  opacity: 0;
  pointer-events: none;
  transition: opacity .2s ease, background-color .2s ease;
}

.menu-btn-fixed.is-scrolled:not(.is-open) .menu-btn-backdrop{
  opacity: 1;
}

.menu-btn-fixed.is-scrolled:not(.is-open){
  color: var(--red);
}

.menu-btn-fixed.is-scrolled:not(.is-open):hover,
.menu-btn-fixed.is-scrolled:not(.is-open):focus-visible{
  color: #fff;
}

.menu-btn-fixed.is-scrolled:not(.is-open):hover .menu-btn-backdrop,
.menu-btn-fixed.is-scrolled:not(.is-open):focus-visible .menu-btn-backdrop{
  background: var(--red);
}

.swap {
  position: relative;
  z-index: 1;
  width: 75px;
  height: 75px;
  display: block;
  transition: transform 320ms cubic-bezier(.22, 1, .36, 1);
}

.menu-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32px;
  height: 2px;
  border-radius: 999px;
  background: currentColor;
  transform-origin: center;
  transition: transform 320ms cubic-bezier(.22, 1, .36, 1), background-color 200ms ease;
}

.menu-line:first-child {
  transform: translate(-50%, -50%) translateY(-2px);
}

.menu-line:last-child {
  transform: translate(-50%, -50%) translateY(7px);
}

.swap.is-on .menu-line:first-child {
  transform: translate(-50%, -50%);
}

.swap.is-on .menu-line:last-child {
  transform: translate(-50%, -50%) rotate(90deg);
}

.menu-btn.is-open .swap {
  transform: rotate(-45deg);
}

.menu-btn.is-closing .swap {
  transform: rotate(0deg);
}



